# Copy to .env.local (gitignored) and fill in with the CommonroomAuthStack outputs.
VITE_OIDC_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<UserPoolId>
VITE_OIDC_CLIENT_ID=<ClientIdProjectAlpha>
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
VITE_COGNITO_DOMAIN=https://<domain-prefix>.auth.<region>.amazoncognito.com
VITE_LOGOUT_URI=http://localhost:5173/

# Reference API (step 2)
VITE_API_BASE=http://localhost:5080
VITE_API_KEY=dev-key
VITE_VECTOR_STORE_ID=<vs_... from Commonroom.VectorSeed>
