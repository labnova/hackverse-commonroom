# Copy to deploy/env.local (gitignored) and edit. One KEY=VALUE per line; text after # is ignored.

# Lowercase letters, digits and '-', 3-16 chars, must not contain aws/amazon/cognito.
# Resource names become <kind>-<PREFIX>-<random suffix generated at the first run>.
PREFIX=myteam

# local-fake    Cognito + local API with the Fake engine (no Azure)
# local-foundry local-fake + Azure Foundry (model + vector store), API still local
# azure         local-foundry + App Service (API) + Static Web App (demo host)
LEVEL=local-fake

AWS_PROFILE=default
AWS_REGION=eu-central-1

AZ_LOCATION=swedencentral
AZ_SWA_LOCATION=westeurope

MODEL_NAME=gpt-5.4-mini
MODEL_VERSION=2026-03-17
MODEL_SKU=GlobalStandard

DOCS_DIR=samples/docs
